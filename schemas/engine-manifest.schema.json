{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jake6956/LastWar-Account_Audit_Engine/schemas/engine-manifest.schema.json",
  "title": "LWAI Modular Engine Manifest",
  "type": "object",
  "required": [
    "engine_version",
    "engine_api_version",
    "schema_version",
    "channel",
    "runtime_mode",
    "sanitized",
    "account_state_included",
    "integrity_mode",
    "modules"
  ],
  "properties": {
    "engine_version": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$"},
    "engine_api_version": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
    "schema_version": {"type": "string"},
    "channel": {"enum": ["RC", "Production"]},
    "runtime_mode": {"type": "string"},
    "sanitized": {"const": true},
    "account_state_included": {"const": false},
    "integrity_mode": {"enum": ["git_blob_sha1"]},
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "module_id",
          "module_version",
          "path",
          "load_class",
          "dependencies",
          "state_scope",
          "required",
          "release_min",
          "engine_api",
          "workspace_schema",
          "integrity"
        ],
        "properties": {
          "module_id": {"type": "string", "minLength": 3},
          "module_version": {"type": "string", "minLength": 3},
          "path": {"type": "string", "pattern": "^engine/modules/"},
          "load_class": {"enum": ["mandatory_core", "domain_on_demand", "capability_on_demand"]},
          "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "state_scope": {"type": "string"},
          "required": {"type": "boolean"},
          "release_min": {"type": "string"},
          "engine_api": {
            "type": "object",
            "required": ["min", "max"],
            "properties": {"min": {"type": "string"}, "max": {"type": "string"}},
            "additionalProperties": false
          },
          "workspace_schema": {
            "type": "object",
            "required": ["min", "max"],
            "properties": {"min": {"type": "string"}, "max": {"type": "string"}},
            "additionalProperties": false
          },
          "integrity": {
            "type": "object",
            "required": ["algorithm", "digest"],
            "properties": {
              "algorithm": {"const": "git_blob_sha1"},
              "digest": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
