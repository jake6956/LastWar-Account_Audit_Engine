{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jake6956/LastWar-Account_Audit_Engine/schemas/engine-manifest.schema.json",
  "title": "LWAI Engine Manifest",
  "type": "object",
  "required": ["engine_version", "schema_version", "channel", "sanitized", "account_state_included", "stable_bootstrap_endpoint", "required_sections"],
  "properties": {
    "engine_version": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$"},
    "schema_version": {"type": "string"},
    "channel": {"enum": ["RC", "Production"]},
    "sanitized": {"const": true},
    "account_state_included": {"const": false},
    "stable_bootstrap_endpoint": {"type": "string", "format": "uri"},
    "required_sections": {"type": "array", "items": {"type": "string"}, "minItems": 10, "uniqueItems": true},
    "migration": {"type": ["string", "null"]},
    "gold_assets_manifest": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
